{
  "autoMemoryEnabled": false,
  "permissions": {
    "allow": [
      "Edit(./context/**)",
      "Edit(./work/**)",
      "Edit(./CLAUDE.md)",
      "WebSearch"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(**/*.key)",
      "Read(**/*.pem)",
      "Bash(rm -rf *)",
      "Bash(git reset --hard *)",
      "Bash(git push --force *)"
    ]
  }
}
